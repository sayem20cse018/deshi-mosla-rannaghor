// ============================================================
// DESHI MOSLAR RANNAGHAR — Prisma Schema
// Version: 2.0 (Production-ready)
// Database: PostgreSQL
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// ENUMS
// ============================================================

enum Role {
  CUSTOMER
  ADMIN
  SUPER_ADMIN
}

enum AdminRole {
  ADMIN
  SUPER_ADMIN
  MANAGER
  SUPPORT
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum StockStatus {
  IN_STOCK
  LOW_STOCK
  OUT_OF_STOCK
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  PACKED
  SHIPPED
  DELIVERED
  CANCELLED
  RETURNED
  REFUNDED
}

enum PaymentMethod {
  CASH_ON_DELIVERY
  BKASH
  NAGAD
  ROCKET
  UPAY
  MOBILE_BANKING
  INTERNET_BANKING
  BANK_TRANSFER
  VISA
  MASTERCARD
  AMEX
  DEBIT_CARD
  CREDIT_CARD
  SSLCOMMERZ
}

enum PaymentStatus {
  PENDING
  PROCESSING
  PAID
  FAILED
  CANCELLED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum CodStatus {
  PENDING
  COLLECTED
  FAILED
}

enum DeliveryStatus {
  PENDING
  ASSIGNED
  PICKED_UP
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  FAILED
  RETURNED
}

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
  FREE_DELIVERY
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum NotificationType {
  ORDER_PLACED
  ORDER_CONFIRMED
  ORDER_SHIPPED
  ORDER_DELIVERED
  ORDER_CANCELLED
  PAYMENT_CONFIRMED
  PAYMENT_FAILED
  REFUND_PROCESSED
  PROMOTIONAL
  LOW_STOCK_ALERT
  SYSTEM
}

enum BannerPosition {
  HERO
  PROMOTIONAL
  CATEGORY_TOP
  HOMEPAGE_MIDDLE
  SIDEBAR
}

enum TransactionStatus {
  INITIATED
  SUCCESS
  FAILED
  CANCELLED
  REFUNDED
}

// ============================================================
// 1. USER
// ============================================================

model User {
  id              String    @id @default(uuid())
  name            String    @db.VarChar(100)
  email           String    @unique @db.VarChar(255)
  phone           String    @unique @db.VarChar(20)
  password        String    @db.VarChar(255)
  role            Role      @default(CUSTOMER)
  avatar          String?   @db.VarChar(500)
  gender          Gender?
  dateOfBirth     DateTime?
  isEmailVerified Boolean   @default(false)
  isPhoneVerified Boolean   @default(false)
  isActive        Boolean   @default(true)
  isBlocked       Boolean   @default(false)
  refreshToken    String?   @db.Text
  otp             String?   @db.VarChar(10)
  otpExpiry       DateTime?
  lastLoginAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Relations
  addresses    Address[]
  cart         Cart?
  wishlists    Wishlist[]
  orders       Order[]
  reviews      Review[]
  notifications Notification[]
  couponUsages CouponUsage[]

  @@index([email])
  @@index([phone])
  @@index([isActive, isBlocked])
  @@map("users")
}

// ============================================================
// 2. ADMIN
// ============================================================

model Admin {
  id          String    @id @default(uuid())
  name        String    @db.VarChar(100)
  email       String    @unique @db.VarChar(255)
  password    String    @db.VarChar(255)
  role        AdminRole @default(ADMIN)
  avatar      String?   @db.VarChar(500)
  isActive    Boolean   @default(true)
  refreshToken String?  @db.Text
  lastLoginAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Relations
  activityLogs AdminActivityLog[]

  @@index([email])
  @@index([isActive])
  @@map("admins")
}

model AdminActivityLog {
  id        String   @id @default(uuid())
  adminId   String
  action    String   @db.VarChar(100)
  entity    String   @db.VarChar(100)
  entityId  String?  @db.VarChar(100)
  details   Json?
  ipAddress String?  @db.VarChar(45)
  createdAt DateTime @default(now())

  // FK
  admin Admin @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
  @@index([createdAt])
  @@map("admin_activity_logs")
}

// ============================================================
// 3. ADDRESS
// ============================================================

model Address {
  id          String   @id @default(uuid())
  userId      String
  label       String?  @db.VarChar(50)
  fullName    String   @db.VarChar(100)
  phone       String   @db.VarChar(20)
  division    String   @db.VarChar(50)
  district    String   @db.VarChar(50)
  area        String   @db.VarChar(100)
  fullAddress String   @db.VarChar(500)
  postalCode  String?  @db.VarChar(10)
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // FK
  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders Order[]

  @@index([userId])
  @@index([userId, isDefault])
  @@map("addresses")
}

// ============================================================
// 4. CATEGORY
// ============================================================

model Category {
  id          String   @id @default(uuid())
  name        String   @db.VarChar(100)
  nameEn      String?  @db.VarChar(100)
  slug        String   @unique @db.VarChar(120)
  description String?  @db.Text
  image       String?  @db.VarChar(500)
  icon        String?  @db.VarChar(100)
  parentId    String?
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  showInNav   Boolean  @default(false)
  navOrder    Int      @default(0)
  metaTitle   String?  @db.VarChar(200)
  metaDesc    String?  @db.VarChar(500)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Self-referential FK (for subcategories)
  parent   Category?  @relation("SubCategories", fields: [parentId], references: [id])
  children Category[] @relation("SubCategories")

  // Relations
  products Product[]

  @@index([slug])
  @@index([parentId])
  @@index([isActive, sortOrder])
  @@index([showInNav, navOrder])
  @@map("categories")
}

// ============================================================
// 5. BRAND
// ============================================================

model Brand {
  id          String   @id @default(uuid())
  name        String   @db.VarChar(100)
  nameEn      String?  @db.VarChar(100)
  slug        String   @unique @db.VarChar(120)
  logo        String?  @db.VarChar(500)
  description String?  @db.Text
  website     String?  @db.VarChar(255)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  products Product[]

  @@index([slug])
  @@index([isActive])
  @@map("brands")
}

// ============================================================
// 6. PRODUCT
// ============================================================

model Product {
  id              String      @id @default(uuid())
  name            String      @db.VarChar(200)
  nameEn          String?     @db.VarChar(200)
  slug            String      @unique @db.VarChar(220)
  sku             String      @unique @db.VarChar(50)
  categoryId      String
  brandId         String?
  description     String?     @db.Text
  ingredients     String?     @db.Text
  usage           String?     @db.Text
  storageInfo     String?     @db.Text
  origin          String?     @db.VarChar(100)
  weight          String?     @db.VarChar(50)
  size            String?     @db.VarChar(50)
  price           Decimal     @db.Decimal(10, 2)
  discountPrice   Decimal?    @db.Decimal(10, 2)
  discountPercent Int?
  minOrderQty     Int         @default(1)
  maxOrderQty     Int?
  stockStatus     StockStatus @default(IN_STOCK)
  isActive        Boolean     @default(true)
  isFeatured      Boolean     @default(false)
  isBestSeller    Boolean     @default(false)
  isNewArrival    Boolean     @default(false)
  tags            String[]    @default([])
  metaTitle       String?     @db.VarChar(200)
  metaDesc        String?     @db.VarChar(500)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  // FK
  category Category  @relation(fields: [categoryId], references: [id])
  brand    Brand?    @relation(fields: [brandId], references: [id])

  // Relations
  images            ProductImage[]
  cartItems         CartItem[]
  wishlistItems     WishlistItem[]
  orderItems        OrderItem[]
  reviews           Review[]
  inventory         Inventory?
  recipeIngredients RecipeIngredient[]

  @@index([slug])
  @@index([sku])
  @@index([categoryId])
  @@index([brandId])
  @@index([isActive, isFeatured])
  @@index([isActive, isBestSeller])
  @@index([isActive, isNewArrival])
  @@index([isActive, stockStatus])
  @@index([price])
  @@map("products")
}

// ============================================================
// 7. PRODUCT IMAGE
// ============================================================

model ProductImage {
  id        String   @id @default(uuid())
  productId String
  url       String   @db.VarChar(500)
  altText   String?  @db.VarChar(200)
  isPrimary Boolean  @default(false)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  // FK
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([productId, isPrimary])
  @@map("product_images")
}

// ============================================================
// 8. INVENTORY
// ============================================================

model Inventory {
  id             String   @id @default(uuid())
  productId      String   @unique
  totalStock     Int      @default(0)
  availableStock Int      @default(0)
  soldQuantity   Int      @default(0)
  reservedStock  Int      @default(0)
  lowStockAlert  Int      @default(10)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // FK
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  // Relations
  logs InventoryLog[]

  @@index([availableStock])
  @@index([productId])
  @@map("inventories")
}

model InventoryLog {
  id          String   @id @default(uuid())
  inventoryId String
  changeQty   Int
  type        String   @db.VarChar(50) // "RESTOCK" | "SALE" | "RETURN" | "ADJUSTMENT"
  reason      String?  @db.VarChar(255)
  reference   String?  @db.VarChar(100)
  createdAt   DateTime @default(now())

  // FK
  inventory Inventory @relation(fields: [inventoryId], references: [id], onDelete: Cascade)

  @@index([inventoryId])
  @@index([createdAt])
  @@map("inventory_logs")
}

// ============================================================
// 9. CART
// ============================================================

model Cart {
  id        String   @id @default(uuid())
  userId    String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // FK
  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Relations
  items CartItem[]

  @@index([userId])
  @@map("carts")
}

// ============================================================
// 10. CART ITEM
// ============================================================

model CartItem {
  id        String   @id @default(uuid())
  cartId    String
  productId String
  quantity  Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // FK
  cart    Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([cartId, productId])
  @@index([cartId])
  @@index([productId])
  @@map("cart_items")
}

// ============================================================
// 11. WISHLIST
// ============================================================

model Wishlist {
  id        String   @id @default(uuid())
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // FK
  user  User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Relations
  items WishlistItem[]

  @@index([userId])
  @@map("wishlists")
}

// ============================================================
// 12. WISHLIST ITEM
// ============================================================

model WishlistItem {
  id         String   @id @default(uuid())
  wishlistId String
  productId  String
  createdAt  DateTime @default(now())

  // FK
  wishlist Wishlist @relation(fields: [wishlistId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([wishlistId, productId])
  @@index([wishlistId])
  @@index([productId])
  @@map("wishlist_items")
}

// ============================================================
// 13. COUPON
// ============================================================

model Coupon {
  id             String       @id @default(uuid())
  code           String       @unique @db.VarChar(50)
  description    String?      @db.VarChar(255)
  discountType   DiscountType
  discountValue  Decimal      @db.Decimal(10, 2)
  minOrderAmount Decimal?     @db.Decimal(10, 2)
  maxDiscount    Decimal?     @db.Decimal(10, 2)
  startDate      DateTime
  expiryDate     DateTime
  usageLimit     Int?
  userLimit      Int          @default(1)
  usedCount      Int          @default(0)
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  // Relations
  usages CouponUsage[]
  orders Order[]

  @@index([code])
  @@index([isActive, expiryDate])
  @@map("coupons")
}

model CouponUsage {
  id       String   @id @default(uuid())
  couponId String
  userId   String
  orderId  String?  @db.VarChar(100)
  usedAt   DateTime @default(now())

  // FK
  coupon Coupon @relation(fields: [couponId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([couponId, userId])
  @@index([couponId])
  @@index([userId])
  @@map("coupon_usages")
}

// ============================================================
// 14. ORDER
// ============================================================

model Order {
  id              String        @id @default(uuid())
  orderNumber     String        @unique @db.VarChar(30)
  userId          String
  addressId       String
  couponId        String?
  status          OrderStatus   @default(PENDING)
  subtotal        Decimal       @db.Decimal(10, 2)
  discountAmount  Decimal       @default(0) @db.Decimal(10, 2)
  couponDiscount  Decimal       @default(0) @db.Decimal(10, 2)
  deliveryCharge  Decimal       @default(0) @db.Decimal(10, 2)
  totalAmount     Decimal       @db.Decimal(10, 2)
  paymentMethod   PaymentMethod
  paymentStatus   PaymentStatus @default(PENDING)
  deliveryNote    String?       @db.VarChar(500)
  estimatedDelivery DateTime?
  confirmedAt     DateTime?
  packedAt        DateTime?
  shippedAt       DateTime?
  deliveredAt     DateTime?
  cancelledAt     DateTime?
  cancelReason    String?       @db.VarChar(500)
  returnedAt      DateTime?
  returnReason    String?       @db.VarChar(500)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  // FK
  user    User     @relation(fields: [userId], references: [id])
  address Address  @relation(fields: [addressId], references: [id])
  coupon  Coupon?  @relation(fields: [couponId], references: [id])

  // Relations
  items         OrderItem[]
  payment       Payment?
  delivery      Delivery?
  statusHistory OrderStatusHistory[]

  @@index([orderNumber])
  @@index([userId])
  @@index([status])
  @@index([paymentStatus])
  @@index([createdAt])
  @@index([userId, status])
  @@map("orders")
}

// ============================================================
// 15. ORDER ITEM
// ============================================================

model OrderItem {
  id            String   @id @default(uuid())
  orderId       String
  productId     String
  productName   String   @db.VarChar(200)
  productSku    String   @db.VarChar(50)
  productImage  String?  @db.VarChar(500)
  quantity      Int
  unitPrice     Decimal  @db.Decimal(10, 2)
  discountPrice Decimal? @db.Decimal(10, 2)
  totalPrice    Decimal  @db.Decimal(10, 2)
  createdAt     DateTime @default(now())

  // FK
  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

model OrderStatusHistory {
  id        String      @id @default(uuid())
  orderId   String
  status    OrderStatus
  note      String?     @db.VarChar(500)
  createdBy String?     @db.VarChar(100)
  createdAt DateTime    @default(now())

  // FK
  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([createdAt])
  @@map("order_status_history")
}

// ============================================================
// 16. PAYMENT
// ============================================================

model Payment {
  id              String        @id @default(uuid())
  orderId         String        @unique
  transactionId   String?       @unique @db.VarChar(100)
  gatewayTxnId    String?       @db.VarChar(200)
  amount          Decimal       @db.Decimal(10, 2)
  paymentMethod   PaymentMethod
  paymentStatus   PaymentStatus @default(PENDING)
  codStatus       CodStatus?
  bankName        String?       @db.VarChar(100)
  accountNumber   String?       @db.VarChar(50)
  paymentRef      String?       @db.VarChar(200)
  gatewayResponse Json?
  verifiedAt      DateTime?
  paidAt          DateTime?
  failedAt        DateTime?
  failureReason   String?       @db.VarChar(500)
  refundedAt      DateTime?
  refundAmount    Decimal?      @db.Decimal(10, 2)
  refundReason    String?       @db.VarChar(500)
  refundTxnId     String?       @db.VarChar(100)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  // FK
  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  // Relations
  transactions PaymentTransaction[]

  @@index([orderId])
  @@index([transactionId])
  @@index([paymentStatus])
  @@index([paymentMethod])
  @@index([createdAt])
  @@map("payments")
}

// ============================================================
// 17. PAYMENT TRANSACTION
// ============================================================

model PaymentTransaction {
  id          String            @id @default(uuid())
  paymentId   String
  txnId       String            @db.VarChar(200)
  amount      Decimal           @db.Decimal(10, 2)
  status      TransactionStatus
  method      PaymentMethod
  gateway     String?           @db.VarChar(50)
  rawResponse Json?
  ipnData     Json?
  createdAt   DateTime          @default(now())

  // FK
  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId])
  @@index([txnId])
  @@index([createdAt])
  @@map("payment_transactions")
}

// ============================================================
// 18. DELIVERY
// ============================================================

model Delivery {
  id             String         @id @default(uuid())
  orderId        String         @unique
  status         DeliveryStatus @default(PENDING)
  courierName    String?        @db.VarChar(100)
  trackingNumber String?        @db.VarChar(100)
  estimatedDate  DateTime?
  deliveredAt    DateTime?
  deliveryCharge Decimal        @db.Decimal(10, 2)
  deliveryNote   String?        @db.VarChar(500)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  // FK
  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([status])
  @@map("deliveries")
}

model DeliveryCharge {
  id           String   @id @default(uuid())
  label        String   @db.VarChar(100)
  division     String?  @db.VarChar(50)
  district     String?  @db.VarChar(50)
  area         String?  @db.VarChar(100)
  charge       Decimal  @db.Decimal(10, 2)
  minOrderFree Decimal? @db.Decimal(10, 2)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([isActive])
  @@index([district])
  @@map("delivery_charges")
}

// ============================================================
// 19. REVIEW
// ============================================================

model Review {
  id        String       @id @default(uuid())
  userId    String
  productId String
  orderId   String?      @db.VarChar(100)
  rating    Int          // 1–5
  title     String?      @db.VarChar(200)
  comment   String?      @db.Text
  images    String[]     @default([])
  status    ReviewStatus @default(PENDING)
  adminNote String?      @db.VarChar(500)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  // FK
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId, orderId])
  @@index([productId])
  @@index([productId, status])
  @@index([userId])
  @@index([rating])
  @@map("reviews")
}

// ============================================================
// 20. RECIPE
// ============================================================

model Recipe {
  id                  String   @id @default(uuid())
  name                String   @db.VarChar(200)
  nameEn              String?  @db.VarChar(200)
  slug                String   @unique @db.VarChar(220)
  coverImage          String?  @db.VarChar(500)
  description         String?  @db.Text
  cookingInstructions String?  @db.Text
  preparationTime     Int?     // minutes
  cookingTime         Int?     // minutes
  servingSize         Int?
  category            String?  @db.VarChar(100)
  difficulty          String?  @db.VarChar(50) // "সহজ" | "মাঝারি" | "কঠিন"
  tags                String[] @default([])
  isActive            Boolean  @default(true)
  viewCount           Int      @default(0)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  // Relations
  ingredients RecipeIngredient[]

  @@index([slug])
  @@index([isActive])
  @@map("recipes")
}

// ============================================================
// 21. RECIPE INGREDIENT
// ============================================================

model RecipeIngredient {
  id         String   @id @default(uuid())
  recipeId   String
  productId  String?
  name       String   @db.VarChar(200)
  quantity   String   @db.VarChar(50)
  unit       String?  @db.VarChar(30)
  isOptional Boolean  @default(false)
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())

  // FK
  recipe  Recipe   @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id])

  @@index([recipeId])
  @@index([productId])
  @@map("recipe_ingredients")
}

// ============================================================
// 22. NOTIFICATION
// ============================================================

model Notification {
  id        String           @id @default(uuid())
  userId    String
  type      NotificationType
  title     String           @db.VarChar(200)
  message   String           @db.Text
  data      Json?
  isRead    Boolean          @default(false)
  readAt    DateTime?
  createdAt DateTime         @default(now())

  // FK
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, isRead])
  @@index([createdAt])
  @@map("notifications")
}

// ============================================================
// 23. BANNER
// ============================================================

model Banner {
  id          String         @id @default(uuid())
  title       String?        @db.VarChar(200)
  titleEn     String?        @db.VarChar(200)
  subtitle    String?        @db.VarChar(300)
  image       String         @db.VarChar(500)
  link        String?        @db.VarChar(300)
  buttonText  String?        @db.VarChar(50)
  position    BannerPosition @default(HERO)
  isActive    Boolean        @default(true)
  sortOrder   Int            @default(0)
  startDate   DateTime?
  endDate     DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([position, isActive])
  @@index([sortOrder])
  @@map("banners")
}

// ============================================================
// 24. TESTIMONIAL
// ============================================================

model Testimonial {
  id         String   @id @default(uuid())
  name       String   @db.VarChar(100)
  role       String?  @db.VarChar(100)
  avatar     String?  @db.VarChar(500)
  rating     Int      @default(5)
  comment    String   @db.Text
  isActive   Boolean  @default(true)
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([isActive, sortOrder])
  @@map("testimonials")
}

// ============================================================
// SITE SETTINGS (key-value store)
// ============================================================

model SiteSettings {
  id          String   @id @default(uuid())
  key         String   @unique @db.VarChar(100)
  value       String   @db.Text
  description String?  @db.VarChar(255)
  group       String?  @db.VarChar(50)
  updatedAt   DateTime @updatedAt

  @@index([key])
  @@index([group])
  @@map("site_settings")
}
