  tagEn         String?  @db.VarChar(100)
  badge         String?  @db.VarChar(100)
  badgeEn       String?  @db.VarChar(100)
  image         String?  @db.VarChar(500)
  imageMobile   String?  @db.VarChar(500)
  ctaLabel      String?  @db.VarChar(100)
  ctaLabelEn    String?  @db.VarChar(100)
  ctaUrl        String?  @db.VarChar(300)
