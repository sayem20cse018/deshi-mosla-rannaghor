  discountType String   @db.VarChar(20)
  discountValue Decimal @db.Decimal(10, 2)
  startDate    DateTime
  endDate      DateTime
  isActive     Boolean  @default(true)
  targetType   String   @default("ALL") @db.VarChar(20)
  targetIds    String[] @default([])
