# ============================================
# BACKEND ENVIRONMENT VARIABLES
# Copy this to .env and fill in your values
# ============================================

NODE_ENV=production
PORT=5000
API_PREFIX=api/v1

# ── URLs ─────────────────────────────────────────────────
# Public URL of this backend (Railway URL). Required in production.
# Used to build SSLCommerz IPN/webhook callback URL.
# Example: https://deshi-mosla-rannaghor-production.up.railway.app
BACKEND_URL=https://your-railway-backend-url.up.railway.app

# Frontend URL (Vercel). Used for payment success/fail/cancel redirects.
FRONTEND_URL=https://your-frontend.vercel.app

# ── Database ──────────────────────────────────────────────
# PostgreSQL (Neon or any PostgreSQL)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# ── JWT Secrets (use strong random strings, min 32 chars) ─
JWT_SECRET=your-jwt-secret-minimum-32-characters-long
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your-refresh-secret-minimum-32-characters-long
JWT_REFRESH_EXPIRES_IN=30d

# Admin JWT
ADMIN_JWT_SECRET=your-admin-jwt-secret-minimum-32-characters
ADMIN_JWT_EXPIRES_IN=1d

# ── Security ──────────────────────────────────────────────
BCRYPT_ROUNDS=12

# ── Cloudinary (for image uploads) ───────────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ── SSLCommerz (payment gateway) ─────────────────────────
# Get credentials from https://developer.sslcommerz.com
# For test mode use store_id=testbox, store_password=qwerty, IS_LIVE=false
SSLCOMMERZ_STORE_ID=your_store_id
SSLCOMMERZ_STORE_PASSWORD=your_store_password
SSLCOMMERZ_IS_LIVE=false

# Payment callback URLs (browser redirects — all go to frontend)
SSLCOMMERZ_SUCCESS_URL=https://your-frontend.vercel.app/payment/success
SSLCOMMERZ_FAIL_URL=https://your-frontend.vercel.app/payment/failed
SSLCOMMERZ_CANCEL_URL=https://your-frontend.vercel.app/payment/cancel

# IPN/Webhook URL (server-to-server — must be BACKEND URL, not frontend)
# If not set, auto-generated from BACKEND_URL + API_PREFIX
# Example: https://your-railway-url.up.railway.app/api/v1/payments/webhook/sslcommerz
SSLCOMMERZ_WEBHOOK_URL=https://your-railway-backend-url.up.railway.app/api/v1/payments/webhook/sslcommerz

# ── WhatsApp ──────────────────────────────────────────────
WHATSAPP_NUMBER=+8801XXXXXXXXX

# ── Rate Limiting ─────────────────────────────────────────
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# ── CORS ─────────────────────────────────────────────────
# Comma-separated allowed origins
CORS_ORIGINS=https://your-frontend.vercel.app
