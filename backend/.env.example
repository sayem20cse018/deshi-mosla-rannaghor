# ============================================
# BACKEND ENVIRONMENT VARIABLES
# Copy this to .env and fill in your values
# ============================================

NODE_ENV=production
PORT=5000
API_PREFIX=api/v1
FRONTEND_URL=https://your-frontend.vercel.app

# PostgreSQL (Neon or any PostgreSQL)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# JWT Secrets (use strong random strings, min 32 chars each)
JWT_SECRET=your-jwt-secret-minimum-32-characters-long
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your-refresh-secret-minimum-32-characters-long
JWT_REFRESH_EXPIRES_IN=30d

# Admin JWT
ADMIN_JWT_SECRET=your-admin-jwt-secret-minimum-32-characters
ADMIN_JWT_EXPIRES_IN=1d

# Bcrypt
BCRYPT_ROUNDS=12

# Cloudinary (for image uploads)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# SSLCommerz (payment gateway - test mode)
SSLCOMMERZ_STORE_ID=testbox
SSLCOMMERZ_STORE_PASSWORD=qwerty
SSLCOMMERZ_IS_LIVE=false
SSLCOMMERZ_SUCCESS_URL=https://your-frontend.vercel.app/payment/success
SSLCOMMERZ_FAIL_URL=https://your-frontend.vercel.app/payment/failed
SSLCOMMERZ_CANCEL_URL=https://your-frontend.vercel.app/payment/cancel

# WhatsApp
WHATSAPP_NUMBER=+8801XXXXXXXXX

# Rate Limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# CORS - comma separated allowed origins
CORS_ORIGINS=https://your-frontend.vercel.app