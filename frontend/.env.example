# ============================================
# FRONTEND ENVIRONMENT VARIABLES
# Copy to .env.local for local dev
# Add these in Vercel Dashboard > Settings > Environment Variables
# ============================================

# Backend API URL (Railway backend URL)
NEXT_PUBLIC_API_URL=https://your-backend.up.railway.app/api/v1

# App Info
NEXT_PUBLIC_APP_NAME=Deshi Moslar Rannaghar
NEXT_PUBLIC_APP_NAME_EN=Deshi Moslar Rannaghar
NEXT_PUBLIC_APP_URL=https://your-frontend.vercel.app

# Social / Contact
NEXT_PUBLIC_WHATSAPP_NUMBER=+8801XXXXXXXXX
NEXT_PUBLIC_FACEBOOK_URL=https://facebook.com/yourpage
NEXT_PUBLIC_INSTAGRAM_URL=https://instagram.com/yourpage
NEXT_PUBLIC_YOUTUBE_URL=https://youtube.com/yourchannel

# Cloudinary (for image display - public vars only)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloud_name
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=your_upload_preset